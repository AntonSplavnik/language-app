DATABASE_URL=postgres://app:app@localhost:5432/language_app
TEST_DATABASE_URL=postgres://app:app@localhost:5432/language_app_test

ANTHROPIC_API_KEY=
AI_MODEL_EXTRACT=claude-haiku-5-5
AI_MODEL_ENRICH=claude-haiku-5-5
AI_MODEL_DESCRIBE=claude-haiku-5-5
AI_EFFORT=medium
DAILY_PHOTO_LIMIT=50
DAILY_DESCRIBE_LIMIT=200

SERVER_PORT=3000
WEB_PORT=5173

# Signs the session cookie; at least 32 characters, never in git: openssl rand -base64 32
BETTER_AUTH_SECRET=
# invite: only emails on the invite list (invite:add) can create an account; open: anyone
SIGNUP_MODE=invite
