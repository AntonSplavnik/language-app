DATABASE_URL=postgres://app:app@localhost:5432/language_app
TEST_DATABASE_URL=postgres://app:app@localhost:5432/language_app_test

ANTHROPIC_API_KEY=
AI_MODEL_EXTRACT=claude-haiku-5-5
AI_MODEL_ENRICH=claude-haiku-5-5
AI_MODEL_DESCRIBE=claude-haiku-5-5
AI_EFFORT=medium
DAILY_PHOTO_LIMIT=50
DAILY_DESCRIBE_LIMIT=200
# The daily limits' day starts at midnight in this IANA time zone, whatever the server's own zone
APP_TIME_ZONE=Europe/Berlin

SERVER_PORT=3000
WEB_PORT=5173

# Signs the session cookie; at least 32 characters, never in git: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Production only (Vercel's variables, docs/design.md §18.3): the app's https address, which makes
# the cookies Secure. Never set it on the Mac: its server refuses to start with it.
# BETTER_AUTH_URL=
# invite: only emails on the invite list (invite:add) can create an account; open: anyone can, by
# password or Google, with AI off, and Create account drops its "Invite only" line. While testing
# (M12.7) production and the Mac run open (docs/design.md §4 Accounts)
SIGNUP_MODE=invite
# Continue with Google (optional: both or neither, never in git). From a Web client in Google
# Cloud whose redirect URI is http://localhost:5173/api/auth/callback/google (docs/design.md §14)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
